{
  "name": "orchestrator",
  "description": "Orchestrator agent that analyzes tasks and delegates to specialized subagents. Entry point for all user requests.",
  "prompt": "file://../prompts/orchestrator.md",
  "welcomeMessage": "Orchestrator ready. Describe your task and I'll route it to the right agent(s).",
  "tools": ["read", "write", "shell", "web", "subagent", "knowledge"],
  "includeMcpJson": false,
  "includePowers": false,
  "permissions": {
    "rules": [
      {
        "capability": "fs_read",
        "match": ["./**"],
        "effect": "allow"
      },
      {
        "capability": "fs_read",
        "match": [
          "config.toml",
          "./config.toml",
          "**/config.toml",
          ".env",
          "./.env",
          "**/.env",
          "**/.env*",
          "*.pem",
          "**/*.pem",
          "*.key",
          "**/*.key",
          "id_rsa",
          "**/id_rsa",
          "id_ed25519",
          "**/id_ed25519",
          "secrets/**",
          "**/credentials",
          "**/.netrc"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_write",
        "match": ["./**"],
        "effect": "allow"
      },
      {
        "capability": "fs_write",
        "match": [
          "config.toml",
          "./config.toml",
          "**/config.toml",
          ".env",
          "./.env",
          "**/.env",
          "*.env",
          "**/*.env",
          "*.pem",
          "**/*.pem",
          "*.key",
          "**/*.key",
          "id_rsa",
          "./id_rsa",
          "**/id_rsa",
          "id_ed25519",
          "./id_ed25519",
          "**/id_ed25519",
          "**/.env*",
          "secrets/**",
          "**/credentials",
          "**/.netrc"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_write",
        "match": [
          "~/.ssh/**",
          "~/.aws/**",
          "~/.gnupg/**",
          "~/.bashrc",
          "~/.bash_profile",
          "~/.profile",
          "~/.zshrc",
          "~/.gitconfig",
          "~/.netrc",
          "~/.kiro/agents/**",
          "~/.kiro/hooks/**",
          "~/.kiro/skills/**"
        ],
        "effect": "deny"
      },
      {
        "capability": "shell",
        "match": [
          "make drift-check",
          "make fmt-check",
          "make hook-test",
          "git status*",
          "git diff*",
          "git log*"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "rm -rf *",
          "rm -fr *",
          "sudo *",
          "su *",
          "chmod 777 *",
          "chmod -R *",
          "dd *",
          "mkfs*",
          "shutdown*",
          "reboot*",
          "eval *",
          "history -c*",
          "npm publish*",
          "pip install *"
        ],
        "effect": "deny"
      },
      {
        "capability": "web_fetch",
        "match": ["*"],
        "effect": "allow"
      },
      {
        "capability": "web_search",
        "match": ["*"],
        "effect": "allow"
      },
      {
        "capability": "subagent",
        "match": ["*"],
        "effect": "allow"
      },
      {
        "capability": "skill",
        "match": ["*"],
        "effect": "allow"
      },
      {
        "capability": "diagnostics",
        "match": ["*"],
        "effect": "allow"
      }
    ]
  },
  "toolsSettings": {
    "subagent": {
      "availableAgents": [
        "software-architect",
        "ai-engineer",
        "data-engineer",
        "senior-developer",
        "security-engineer",
        "code-reviewer",
        "qa-engineer",
        "platform-engineer",
        "technical-writer"
      ],
      "trustedAgents": ["*"]
    }
  },
  "resources": [
    "file://.kiro/orchestration/routing.md",
    "file://.kiro/orchestration/delegation-lifecycle.md",
    "skill://.kiro/skills/*/SKILL.md",
    "file://tools/TOOLS_OVERVIEW.md",
    {
      "type": "knowledgeBase",
      "source": "file://.kiro/skills/kiro-cli-reference/references",
      "name": "KiroCLIDocs",
      "description": "Kiro CLI official documentation, vendored and synced by `make sync-docs`. Search for agent-system topics: CLI commands and slash commands, custom agent configuration, permissions, hooks, MCP servers, steering, skills, subagents, models and settings.",
      "indexType": "best",
      "autoUpdate": false
    }
  ],
  "model": "claude-sonnet-5.5"
}
