{
  "name": "engagement-manager",
  "description": "Client engagement strategy, validation roadmaps, phased deliverables, data governance, stakeholder alignment",
  "prompt": "file://../prompts/engagement-manager.md",
  "tools": ["read", "write", "web"],
  "includeMcpJson": false,
  "includePowers": false,
  "permissions": {
    "rules": [
      {
        "capability": "fs_read",
        "match": ["./**"],
        "effect": "allow"
      },
      {
        "capability": "fs_read",
        "match": [
          "config.toml",
          "./config.toml",
          "**/config.toml",
          ".env",
          "./.env",
          "**/.env",
          "**/.env*",
          "*.pem",
          "**/*.pem",
          "*.key",
          "**/*.key",
          "id_rsa",
          "**/id_rsa",
          "id_ed25519",
          "**/id_ed25519",
          "secrets/**",
          "**/credentials",
          "**/.netrc"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_write",
        "match": ["./**"],
        "effect": "allow"
      },
      {
        "capability": "fs_write",
        "match": [
          "config.toml",
          "./config.toml",
          "**/config.toml",
          ".env",
          "./.env",
          "**/.env",
          "*.env",
          "**/*.env",
          "*.pem",
          "**/*.pem",
          "*.key",
          "**/*.key",
          "id_rsa",
          "./id_rsa",
          "**/id_rsa",
          "id_ed25519",
          "./id_ed25519",
          "**/id_ed25519"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_write",
        "match": [
          "~/.ssh/**",
          "~/.aws/**",
          "~/.gnupg/**",
          "~/.bashrc",
          "~/.bash_profile",
          "~/.profile",
          "~/.zshrc",
          "~/.gitconfig",
          "~/.netrc",
          "~/.kiro/agents/**",
          "~/.kiro/hooks/**",
          "~/.kiro/skills/**"
        ],
        "effect": "deny"
      },
      {
        "capability": "shell",
        "match": ["*"],
        "effect": "deny"
      },
      {
        "capability": "web_fetch",
        "match": ["*"],
        "effect": "allow"
      },
      {
        "capability": "web_search",
        "match": ["*"],
        "effect": "allow"
      },
      {
        "capability": "skill",
        "match": ["*"],
        "effect": "allow"
      },
      {
        "capability": "diagnostics",
        "match": ["*"],
        "effect": "allow"
      }
    ]
  },
  "resources": ["skill://.kiro/skills/engagement-plan/SKILL.md"],
  "welcomeMessage": "Ready for engagement planning. What's the client context?",
  "model": "claude-haiku-4.5"
}
