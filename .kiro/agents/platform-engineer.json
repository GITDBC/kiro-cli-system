{
  "name": "platform-engineer",
  "description": "CI/CD pipelines, IaC, Docker, Kubernetes, SLOs, observability, deployment strategies, production reliability",
  "prompt": "file://../prompts/platform-engineer.md",
  "tools": ["read", "write", "shell"],
  "includeMcpJson": false,
  "includePowers": false,
  "permissions": {
    "rules": [
      {
        "capability": "fs_read",
        "match": ["./**"],
        "effect": "allow"
      },
      {
        "capability": "fs_read",
        "match": [
          "config.toml",
          "./config.toml",
          "**/config.toml",
          ".env",
          "./.env",
          "**/.env",
          "**/.env*",
          "*.pem",
          "**/*.pem",
          "*.key",
          "**/*.key",
          "id_rsa",
          "**/id_rsa",
          "id_ed25519",
          "**/id_ed25519",
          "secrets/**",
          "**/credentials",
          "**/.netrc"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_write",
        "match": ["./**"],
        "effect": "allow"
      },
      {
        "capability": "fs_write",
        "match": [
          "config.toml",
          "./config.toml",
          "**/config.toml",
          ".env",
          "./.env",
          "**/.env",
          "*.env",
          "**/*.env",
          "*.pem",
          "**/*.pem",
          "*.key",
          "**/*.key",
          "id_rsa",
          "./id_rsa",
          "**/id_rsa",
          "id_ed25519",
          "./id_ed25519",
          "**/id_ed25519",
          "**/.env*",
          "secrets/**",
          "**/credentials",
          "**/.netrc"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_write",
        "match": [
          "~/.ssh/**",
          "~/.aws/**",
          "~/.gnupg/**",
          "~/.bashrc",
          "~/.bash_profile",
          "~/.profile",
          "~/.zshrc",
          "~/.gitconfig",
          "~/.netrc",
          "~/.kiro/agents/**",
          "~/.kiro/hooks/**",
          "~/.kiro/skills/**"
        ],
        "effect": "deny"
      },
      {
        "capability": "shell",
        "match": [
          "docker *",
          "kubectl *",
          "terraform *",
          "helm *",
          "git *",
          "uv *",
          "make *"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": ["uv add*", "uv pip install*", "uv sync*"],
        "effect": "ask"
      },
      {
        "capability": "shell",
        "match": [
          "rm -rf *",
          "rm -fr *",
          "sudo *",
          "su *",
          "chmod 777 *",
          "chmod -R *",
          "dd *",
          "mkfs*",
          "shutdown*",
          "reboot*",
          "eval *",
          "history -c*",
          "npm publish*",
          "pip install *"
        ],
        "effect": "deny"
      },
      {
        "capability": "shell",
        "match": [
          "terraform apply*",
          "terraform destroy*",
          "terraform import*",
          "terraform state*",
          "kubectl delete *",
          "kubectl drain *",
          "kubectl cordon *",
          "helm uninstall *",
          "helm delete *",
          "helm rollback *",
          "docker rm *",
          "docker rmi *",
          "docker system prune*",
          "docker volume rm *"
        ],
        "effect": "ask"
      },
      {
        "capability": "skill",
        "match": ["*"],
        "effect": "allow"
      },
      {
        "capability": "diagnostics",
        "match": ["*"],
        "effect": "allow"
      }
    ]
  },
  "resources": [],
  "welcomeMessage": "Ready for platform work. What needs building or stabilizing?",
  "model": "claude-sonnet-5.5"
}
